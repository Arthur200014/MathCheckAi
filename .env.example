OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct
OLLAMA_SOLVER_MODEL=qwen3-vl:4b-instruct
OLLAMA_GRADER_MODEL=qwen3-vl:4b-instruct
OLLAMA_REVIEWER_MODEL=qwen3-vl:4b-instruct
OLLAMA_KEEP_ALIVE=15m

# Таймауты Ollama.
# First-chunk timeout отдельно от idle: Vision может долго кодировать изображение
# до первого токена, но после начала генерации поток не должен зависать.
OLLAMA_CONNECT_TIMEOUT_SECONDS=15
OLLAMA_IDLE_TIMEOUT_SECONDS=180
OLLAMA_VISION_FIRST_CHUNK_TIMEOUT_SECONDS=300
OLLAMA_TEXT_FIRST_CHUNK_TIMEOUT_SECONDS=120
OLLAMA_VISION_TOTAL_TIMEOUT_SECONDS=900
OLLAMA_TEXT_TOTAL_TIMEOUT_SECONDS=300

# Vision OCR: strict JSON schema + bounded context/output.
OLLAMA_VISION_NUM_CTX=8192
OLLAMA_VISION_NUM_PREDICT=3072

# Generic defaults used only by calls that do not override them explicitly.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2048
MATHCHECK_SLOW_AGENT_SECONDS=120
