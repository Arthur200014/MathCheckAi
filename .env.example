OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct
OLLAMA_SOLVER_MODEL=qwen3-vl:4b-instruct
OLLAMA_GRADER_MODEL=qwen3-vl:4b-instruct
OLLAMA_REVIEWER_MODEL=qwen3-vl:4b-instruct
OLLAMA_KEEP_ALIVE=15m

# Stage 2.9.7.3: transport inherited unchanged from 2.9.7.2.
# IMPORTANT: OLLAMA_TIMEOUT_SECONDS from older stages is intentionally ignored.
OLLAMA_CONNECT_TIMEOUT_SECONDS=15
OLLAMA_IDLE_TIMEOUT_SECONDS=180
OLLAMA_VISION_TOTAL_TIMEOUT_SECONDS=900
OLLAMA_TEXT_TOTAL_TIMEOUT_SECONDS=900

# Active streams may run longer than ordinary requests. 900 s is an emergency
# ceiling, not a normal working timeout. Partial JSON is never consumed downstream.
# Vision: original bytes, 16k context, no custom output-token cap.
OLLAMA_VISION_NUM_CTX=16384

# Generic defaults used only by calls that do not override them explicitly.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2048
MATHCHECK_SLOW_AGENT_SECONDS=120
